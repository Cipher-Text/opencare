{
  "name": "contributor-management",
  "version": "1.0.0",
  "description": "Automated contributor management for multiple repositories",
  "scripts": {
    "contributors:update": "python scripts/update_contributors.py",
    "contributors:check": "python scripts/check_contributors.py",
    "contributors:validate": "python scripts/validate_contributors.py",
    "contributors:stats": "python scripts/contributor_stats.py",
    "setup": "pip install -r requirements.txt",
    "test": "python -m pytest tests/",
    "lint": "flake8 scripts/"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:Cipher-Text/opencare.git"
  },
  "keywords": [
    "contributors",
    "automation",
    "github",
    "opensource"
  ],
  "author": "Sadman Sobhan",
  "license": "MIT",
  "devDependencies": {
    "husky": "^8.0.0",
    "lint-staged": "^13.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.py": [
      "flake8",
      "git add"
    ]
  }
}